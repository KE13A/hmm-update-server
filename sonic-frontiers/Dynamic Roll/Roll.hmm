Code "Grounded Rolling Animation Changes"
//
    #include "BlackboardStatus" noemit

    #lib "Player"
    #lib "Time"
    #lib "BlackboardStatus"

    #import "RollLibrary"

    #load "System.Numerics.dll"
    #load "WindowsBase.dll"

    using System.IO;
    using System.Numerics;

    static float headLandingTime = 0.0f;
    static float unRollTargetTime = 0.04f; //0.065f

    static bool airFlipLand = false;
    static float airFlipLandTimer;
    static float airFlipLandTime = 0.0f;
//
{
    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
    var previousState = Player.State.GetPreviousStateID<Sonic.StateID>();

    float currentSpeed = Player.Kinematics.GetMagnitude();

    airFlipLandTimer = ((0.5f / currentSpeed) + 0.12f);

    if (!Player.Status.IsGrounded() || RollLibrary.spinDashCharging)
    {
        return;
    }

    // Landing Check
    if (Player.Status.IsGrounded() && RollLibrary.Jumped)
    {
        if (RollLibrary.GetAirFlip())
        {
            airFlipLand = true;
            airFlipLandTime = airFlipLandTimer;
            RollLibrary.SetAirFlip(false);
        }
    }

    // Air Flip Landing Animation
    if (airFlipLand && currentState is Sonic.StateID.StateRun)
    {
        if (airFlipLandTime > 0.0f)
        {
            airFlipLandTime -= Time.GetDeltaTime() * RollLibrary.timeScale;
            Player.Animation.SetAnimation("SPRING_LANDING");
        }
        else
        {
            airFlipLandTime = 0.0f;
            Player.State.SetState(Sonic.StateID.StateStandRoot);      
            Player.State.SetState(Sonic.StateID.StateRun);  
            airFlipLand = false;    
        }
    }
    else
    {
        airFlipLandTime = 0.0f
    }


    // Roll Entering and Exiting Animations
    if (currentState == Sonic.StateID.StateSpringJumpHeadLand)
    {
        headLandingTime += Time.GetDeltaTime() * RollLibrary.timeScale;

        // Fixes Sonic entering his idle animation when exiting StateSpringJumpHeadLand at a 90 degree angle. 
        var kinematics = Player.Kinematics.Get();
        if (kinematics != null)
        {
            float dotProduct = Vector3.Transform(Vector3.UnitY, kinematics->Rotation).Y;

            if (dotProduct < 0.6f)
            {
                Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateRun);
            }
        }

        // Pre Roll Animation
        if (RollLibrary.rollInputDown && RollLibrary.preRoll)
        {
            Player.Effect.StopAnimationEffects();
            Player.Animation.SetAnimation("JUMP_BALL");
        }

        // Roll Exit Animation
        if (RollLibrary.rollInputReleased && RollLibrary.Rolled)
        {
            if (headLandingTime > 0.0f && headLandingTime < unRollTargetTime)
            {
                Player.Effect.PlayAnimationEffect("SPINJUMP");
            }
            else if (headLandingTime >= unRollTargetTime)
            {
                Player.Effect.StopAnimationEffects();
                Player.Animation.SetAnimation("JUMP_BALL");
            }
        }

        // Spin Dash to Run Exit Animation
        if (previousState == Sonic.StateID.StateSpinBoost && currentSpeed > 10.0f)
        {
            if (headLandingTime < (unRollTargetTime + 0.05f))
            {
                Player.Effect.StopAnimationEffects();
                Player.Animation.SetAnimation("JUMP_BALL");
            }
            else if (headLandingTime >= (unRollTargetTime + 0.05f))
            {
                Player.State.SetState(Sonic.StateID.StateSpringJumpHeadLand);  
            }
        }
    }
    else
    {
        headLandingTime = 0.0f;     
    }

    if (previousState == Sonic.StateID.StateSpringJumpHeadLand)
    {
        if (RollLibrary.rollInputReleased)
        {
            Player.Effect.StopAnimationEffects();
        }
    }
}


Code "Aerial Rolling Animation Changes"
//
    #lib "Player"

    #import "RollLibrary"

    static float preRollTargetTime = 0.095f;
    static float releaseTimer;
    static float releaseTime = 0.0f;
    static bool airRolled = false;
    static string fallAnimation = "";
    static bool hasStateChanged = false;
    static Sonic.StateID jumpState;
//
{
    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
    var previousState = Player.State.GetPreviousStateID<Sonic.StateID>();

    float horizontalSpeed = Player.Kinematics.GetHorizontalMagnitude();
    float currentSpeed = Player.Kinematics.GetMagnitude();
    float releaseRollTargetTime = 0.5f - (20.0f / (currentSpeed + 35.0f)); 

    hasStateChanged = (previousState != currentState) ? true : false;

    // Console.WriteLine($"Air Roll is: {RollLibrary.GetAirRoll()}");

    if (releaseRollTargetTime > 0.1875f)
    {
        releaseTimer = releaseRollTargetTime;
    }
    else
    { 
        releaseTimer = 0.1875f;   
    }

    //releaseTimer = 0.15f;


    if (Player.Status.IsGroundedSpecial() || !RollLibrary.Jumping || (RollLibrary.GetAirFlip() && (jumpState != currentState && hasStateChanged)))
    {
        if (!RollLibrary.GetAirRoll())
        {
            if (Player.GetPlayerType() != Player.PlayerType.Sonic && RollLibrary.currentFriendsAerialState)
            {
                Player.Effect.StopAnimationEffects();
            }
        }

        releaseTime = 0.0f;
        airRolled = false;
        RollLibrary.SetAirFlip(false);
        return;
    }    

    void StartFlip()
    {
        if (!RollLibrary.GetAirFlip())
        {
            fallAnimation = (horizontalSpeed >= 70.0f) ? "SELECTJUMP_MISS_LOOP" : "FALL"; // BUMP_JUMP_FALL or BUMP_JUMP_FALL DIVE_DAMAGE
            releaseTime = releaseTimer;
            airRolled = false;
            jumpState = currentState;
            RollLibrary.SetAirFlip(true);
        }
    }

    if (RollLibrary.GetAirRoll() && !airRolled)
    {
        airRolled = true;   
        RollLibrary.SetAirFlip(false);
    }

    if (RollLibrary.rollInputPressed)
    {
        releaseTime = 0.0f;
    }

    if (RollLibrary.rollInputDown)
    {
        if ((currentState is Sonic.StateID.StateJump or Sonic.StateID.StateFall) && (RollLibrary.Rolled))
        {
            RollLibrary.rollInputPressedTime = 1.0f;
        }

        if ((currentState is Sonic.StateID.StateJump or Sonic.StateID.StateFall) && RollLibrary.previousFriendAerialStates)
        {
            RollLibrary.rollInputPressedTime = 1.0f;
        }       
    }

    if (RollLibrary.rollInputReleased)
    {
        if (airRolled)
        {
            StartFlip();
        }
    }

    // Air Roll Animation Sequence
    if (airRolled && !RollLibrary.GetAirFlip())
    {
        if (RollLibrary.rollInputPressedTime > 0.0f && RollLibrary.rollInputPressedTime < preRollTargetTime)
        {
            Player.Effect.StopAnimationEffects();
            Player.Animation.SetAnimation("JUMP_BALL");   
        }
        else if (RollLibrary.rollInputPressedTime >= preRollTargetTime)
        {
            Player.Effect.PlayAnimationEffect("SPINJUMP");
            //Player.Animation.SetAnimation("SPIN"); 
            Player.Animation.SetAnimation("SPIN_LOOP"); //Sonic.Animation.SetAnimation("SPIN_LOOP");
        }
    }

    // Air Flip Animation Sequence
    if (!RollLibrary.GetAirRoll() && RollLibrary.GetAirFlip())
    {
        Player.Effect.StopAnimationEffects();

        if(releaseTime > 0.0f)
        {
            Player.Animation.SetAnimation("JUMP_BALL");
            releaseTime -= Time.GetDeltaTime() * RollLibrary.timeScale;
            //Player.Animation.SetAnimationParameter("LR", 100.0f);
        }
        else 
        {
            releaseTime = 0.0f;

            Player.Animation.SetAnimation(fallAnimation);
            Player.Animation.SetAnimationParameter("LR", 100.0f);
        }    
    }
}

