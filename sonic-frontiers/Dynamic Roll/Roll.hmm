//===========================================================================================================
// Rolling Functionality
Code "Dynamic Roll" in "Gameplay" by "KE13A" 
//
	#include "Reflection" noemit
    #include "BlackboardStatus" noemit

    #lib "BlackboardStatus"
    #lib "Time"
    #lib "Globals"
    #lib "Memory"
    #lib "Player"

    #import "Plugins"
    #import "RollLibrary"

    #load "System.Numerics.dll"

    using System.Numerics; 

    static float springLandTimer = 0.0f;
//
{
    Globals.Set("Drop Dash Over Spin Dash", false);

    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
    var previousState = Player.State.GetPreviousStateID<Sonic.StateID>();

    var kinematics = Player.Kinematics.Get();
    float currentSpeed = Player.Kinematics.GetMagnitude();

    if (BlackboardStatus.Get() == null || BlackboardStatus.IsSuper())
    {
        return;
    }

    if (IS_WORLD_FLAG(IsAutoRun))
    {
        if (RollLibrary.Rolling)
        {
            Player.State.SetState(Sonic.StateID.StateSpringJumpHeadLand);
        }
        else
        {
            return;
        }
    }


    // === State Redirects & Discards ===
    Player.State.Discard<Sonic.StateID>(Sonic.StateID.StateSpinBoostCharge);
    Player.State.Discard<Amy.StateID>(Amy.StateID.StateSpinBoostCharge);
    Player.State.Discard<Knuckles.StateID>(Knuckles.StateID.StateSpinBoostCharge);
    Player.State.Discard<Tails.StateID>(Tails.StateID.StateSpinBoostCharge);

    Player.State.Redirect<Sonic.StateID>(Sonic.StateID.StateSpinBoost, Sonic.StateID.StateDriftDash);
    Player.State.Redirect<Amy.StateID>(Amy.StateID.StateSpinBoost, Amy.StateID.StateDriftDash);
    Player.State.Redirect<Knuckles.StateID>(Knuckles.StateID.StateSpinBoost, Knuckles.StateID.StateDriftDash);
    Player.State.Redirect<Tails.StateID>(Tails.StateID.StateSpinBoost, Tails.StateID.StateDriftDash);

    if (RollLibrary.Rolling)
    {
        Player.State.Discard<Sonic.StateID>(Sonic.StateID.StateDropDash);
        Player.State.Discard<Amy.StateID>(Amy.StateID.StateDropDash);
        Player.State.Discard<Knuckles.StateID>(Knuckles.StateID.StateDropDash);
        Player.State.Discard<Tails.StateID>(Tails.StateID.StateDropDash);
    }
    else
    {
        Player.State.Restore<Sonic.StateID>(Sonic.StateID.StateDropDash);
        Player.State.Restore<Amy.StateID>(Amy.StateID.StateDropDash);
        Player.State.Restore<Knuckles.StateID>(Knuckles.StateID.StateDropDash);
        Player.State.Restore<Tails.StateID>(Tails.StateID.StateDropDash);         
    }


    // === Functions ===
    void SetStateToRoll()
    {
        if (RollLibrary.spinDashCharging)
        {
            return;
        }

        if (currentSpeed > RollLibrary.minimumRollSpeed)
        {
            if (RollLibrary.preRoll)
            {
                Player.State.SetState(Sonic.StateID.StateSpringJumpHeadLand);
            }
            else
            {
                if (Player.Status.IsSideView())
                {
                    Player.State.SetState(Sonic.StateID.StateSpin);
                    var vel = kinematics->Velocity;
                    kinematics->Velocity = vel;
                }
                else
                {
                    Player.State.SetState(Sonic.StateID.StateDriftDash);
                }
            }
        }
    }


    // === Input Pressed ===
    if (RollLibrary.rollInputPressed)
    {
        // Airborne Roll
        if (!Player.Status.IsGroundedSpecial() && (RollLibrary.Jumping || RollLibrary.BoomKickOutOfCombat))
        {
            RollLibrary.SetAirRoll(true);
        }
    }


    // === Input Down ===
    if (RollLibrary.rollInputDown)
    {
        // Airborne Roll
        if (!Player.Status.IsGroundedSpecial() && (currentState is Sonic.StateID.StateJump or Sonic.StateID.StateFall))
        {
            if (RollLibrary.Rolled)
            {
                RollLibrary.SetAirRoll(true); 
            } 

            if (RollLibrary.previousFriendAerialStates)
            {
                RollLibrary.SetAirRoll(true); 
            }

            // if (Player.GetPlayerType() == Player.PlayerType.Amy && Player.State.GetPreviousStateID<Amy.StateID>() == Amy.StateID.StateHighJump)
            // {
            //     Player.State.SetState(Sonic.StateID.StateFall);
            //     var vel = kinematics->Velocity;
            //     kinematics->Velocity = vel;
            //     Player.State.SetState(Sonic.StateID.StateSpinBoostCharge); 
            //     RollLibrary.SetAirRoll(true);
            // }
        }

        // === Entering & Exiting checks ===       
        if (Player.Status.IsGrounded())
        {
            float preRollTargetTime = ((10.0f / (currentSpeed + 20)));

            if (preRollTargetTime < 0.275f)
            {
                RollLibrary.preRollTransitionTime = preRollTargetTime;
            }
            else
            {
                RollLibrary.preRollTransitionTime = 0.275f;            
            }

            // Re-enter Roll if Input is held while landing
            if (RollLibrary.GetAirRoll() && currentState != Sonic.StateID.StateRecoveryJump)
            {
                if (previousState == Sonic.StateID.StateStompingDown)
                {
                    Player.State.SetState(Sonic.StateID.StateSpringJumpHeadLand);
                    var vel = kinematics->Velocity;
                    kinematics->Velocity = vel;
                }

                SetStateToRoll();
            }

            // Grounded Rolling Transition
            if (!RollLibrary.GetAirRoll() && (RollLibrary.Rolling || currentState == Sonic.StateID.StateSpringJumpHeadLand) && (RollLibrary.rollInputPressedTime < RollLibrary.preRollTransitionTime))
            {
                RollLibrary.preRoll = true;
            }
            else
            {
                RollLibrary.preRoll = false;
            }

            if (!RollLibrary.GetAirRoll() && (currentState is Sonic.StateID.StateRun or Sonic.StateID.StateSpinBoost or Sonic.StateID.StateSliding or Sonic.StateID.StateSpinBoostCharge))
            {
                SetStateToRoll();
            }

            if (!RollLibrary.GetAirRoll() && (previousState is Sonic.StateID.StateSliding or Sonic.StateID.StateSpinBoostCharge))
            {
                SetStateToRoll();
            }

            RollLibrary.SetAirRoll(false);
        }
    }


    // === Input Release ===
    if (RollLibrary.rollInputReleased)
    {
        if (RollLibrary.Rolling || RollLibrary.preRoll)
        {
            var vel = kinematics->Velocity;
            if (Player.Input.IsPressed(Player.InputActionType.PlayerJump))
            {
                Player.State.SetState(Sonic.StateID.StateBaseJump);
                kinematics->Velocity = vel;
            }
            else if (Player.Input.IsDown(Player.InputActionType.PlayerBoost))
            {
                if (Memory.TryGetPointer<StatePluginBoost>(Player.State.GetStatePlugin<StatePluginBoost>(), out var out_pStatePluginBoost))
                {
                    if ((out_pStatePluginBoost->Flags & StatePluginBoost.BoostFlags.IsGaugeEmpty) == 0)
                    {
                        Player.State.SetState(Sonic.StateID.StateStandRoot);
                        SET_STATE_FLAG(IsBoost, true);
                    }
                }
            }
            else if (Player.Status.IsGrounded())
            {
                Player.State.SetState(Sonic.StateID.StateSpringJumpHeadLand);
            }
        }

        RollLibrary.preRoll = false;
        RollLibrary.SetAirRoll(false);
    }


    // === Air Roll exit handling ===
    if (RollLibrary.GetAirRoll())
    {
        if (Player.Input.IsPressed(Player.InputActionType.PlayerStomping))
        {
            Player.State.SetState(Sonic.StateID.StateStompingDown);
            RollLibrary.SetAirRoll(false);
        }

        if (RollLibrary.currentFriendsAerialState || currentState == Sonic.StateID.StateBounceJump)
        {
            RollLibrary.SetAirRoll(false);
        }
    }


    // === SpringJumpHeadLand exit handling ===
    if (currentState == Sonic.StateID.StateSpringJumpHeadLand && RollLibrary.Rolled)
    {
        var vel = kinematics->Velocity;
        springLandTimer += Time.GetDeltaTime();

        if (Player.Input.IsPressed(Player.InputActionType.PlayerJump))
        {
            Player.State.SetState(Sonic.StateID.StateBaseJump);
            springLandTimer = 0.0f;
        }
        else if (Player.Input.IsPressed(Player.InputActionType.PlayerStomping) && Player.GetPlayerType() == Player.PlayerType.Sonic)
        {
            Player.State.SetState(Sonic.StateID.StateSliding);
            springLandTimer = 0.0f;
        }
        else if (Player.Input.IsPressed(Player.InputActionType.PlayerBoost))
        {
            Player.State.SetState(Sonic.StateID.StateStandRoot);
            springLandTimer = 0.0f;
        }
        else if (springLandTimer >= 0.2f)
        {
            if (Player.Status.IsGrounded())
            {
                if (RollLibrary.rollInputDown)
                {
                    SetStateToRoll();
                }
                else if (Player.Input.IsDown(Player.InputActionType.PlayerStomping) && Player.GetPlayerType() == Player.PlayerType.Sonic)
                {
                    Player.State.SetState(Sonic.StateID.StateSliding);
                }
                else
                {
                    Player.State.SetState(Sonic.StateID.StateRun);
                }
            }
            else
            {
                Player.State.SetState(Sonic.StateID.StateFall);
                kinematics->Velocity = vel;
            }
            springLandTimer = 0.0f;
        }
        else if (kinematics != null)
        {
            float dotProduct = Vector3.Dot(Vector3.Transform(Vector3.UnitY, kinematics->Rotation), Vector3.UnitY);

            if (dotProduct < 0.01f)
            {
                Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateRun);
            }
        }
    }
    else
    {
        springLandTimer = 0.0f;
    }

    //Console.WriteLine($"Current Speed is: {currentSpeed}");
}



Code "Spin Dash" by "KE13A" 
//
	#include "Reflection" noemit
    #include "BlackboardStatus" noemit

    #lib "HMM"
    #lib "INI"
    #lib "Player"
    #lib "BlackboardStatus"
    #lib "Time"

    #import "GOComponents"
    #import "RollLibrary"

    #load "System.Numerics.dll"

    using System.Numerics;

    static bool IsConfigInitialised = false;
    static int SpinDashType = 2;
    static int SpinDashVelocityType = 0;
    static int SpinDashSpeed = 10;


    static bool isVelocityAdded = false;
    static bool holdCharge = false;
    static float chargeCount = 1.0f;
//
{

    if (!IsConfigInitialised)
    {
        var modsQuery = HMM.FindModsByName("Dynamic Roll");
        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "config.ini");
            var ini = INI.Read(modConfigIniPath);

            SpinDashType = INI.Parse<int>(ini["SpinDashSettings"]["SpinDashType"], SpinDashType);
            SpinDashVelocityType = INI.Parse<int>(ini["SpinDashSettings"]["SpinDashVelocityType"], SpinDashVelocityType);
            SpinDashSpeed = INI.Parse<int>(ini["SpinDashSettings"]["SpinDashSpeed"], SpinDashSpeed);

        }

        IsConfigInitialised = true;
    }

    switch (SpinDashType)
    {
        case 0:
            return;

        case 1:
            holdCharge = false;
            break;

        case 2:
            holdCharge = true;
            break;
        
        default:
            break;
    }


    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
    var previousState = Player.State.GetPreviousStateID<Sonic.StateID>();


    if (!Player.Status.IsGrounded() || currentState == Sonic.StateID.StateBounceJump)
    {
        RollLibrary.spinDashCharging = false;
        RollLibrary.canSpinCharge = false;
        return;
    }

    if (!Memory.TryGetPointer<GOCPlayerKinematicParams>(Player.Kinematics.Get(), out var out_pKinematics))
    {
        return;
    }

    var worldInput = out_pKinematics->WorldInput;

    if (((currentState is Sonic.StateID.StateRun or Sonic.StateID.StateSquat or Sonic.StateID.StateSliding or Sonic.StateID.StateSpringJumpHeadLand) || RollLibrary.Rolling) 
    && Player.Input.IsDown(Player.InputActionType.PlayerStomping))
    {
        RollLibrary.canSpinCharge = true;
        Player.State.Restore<Sonic.StateID>(Sonic.StateID.StateSpinBoostCharge);
        Player.State.Restore<Amy.StateID>(Amy.StateID.StateSpinBoostCharge);
        Player.State.Restore<Knuckles.StateID>(Knuckles.StateID.StateSpinBoostCharge);
        Player.State.Restore<Tails.StateID>(Tails.StateID.StateSpinBoostCharge);
    }
    else
    {
        RollLibrary.canSpinCharge = false;
        Player.State.Discard<Sonic.StateID>(Sonic.StateID.StateSpinBoostCharge);
        Player.State.Discard<Amy.StateID>(Amy.StateID.StateSpinBoostCharge);
        Player.State.Discard<Knuckles.StateID>(Knuckles.StateID.StateSpinBoostCharge);
        Player.State.Discard<Tails.StateID>(Tails.StateID.StateSpinBoostCharge);  
    }


    // Spin Dash Charge
    if ((holdCharge ? RollLibrary.rollInputDown : RollLibrary.rollInputPressed) && (RollLibrary.canSpinCharge || currentState == Sonic.StateID.StateSpinBoostCharge))
    {
        RollLibrary.spinDashCharging = true;
        Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateSpinBoostCharge);

        if (chargeCount < 6)
        {
            chargeCount += (holdCharge ? 0.055f : 1.5f);     
        }
        else if (chargeCount > 6)
        {
            chargeCount = 6.0f;
        }
    }
    else
    {
        chargeCount -= 0.035f;
    }


    // Spin Dash Reset
    if (RollLibrary.spinDashCharging)
    {
        if (chargeCount <= 0)
        {
            RollLibrary.spinDashCharging = false;
            Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateSpringJumpHeadLand);      
        }

        if (Player.Input.IsReleased(Player.InputActionType.PlayerStomping))
        {
            RollLibrary.spinDashCharging = false;

            if (worldInput.Length() == 0.0f && !RollLibrary.rollInputDown)
            {
                Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateSpringJumpHeadLand);
            }
            else if (previousState == Sonic.StateID.StateSpinBoostCharge && currentState == Sonic.StateID.StateSpinBoost)
            {
                Player.State.SetState<Sonic.StateID>(RollLibrary.rollInputDown ? Sonic.StateID.StateDropDash : Sonic.StateID.StateSpringJumpHeadLand)

                if (!isVelocityAdded)
                {
                    var kinematics = Player.Kinematics.Get();

                    if (kinematics == null)
                    {
                        return;
                    }

                    var newVelocity = Player.Kinematics.GetForward() * (chargeCount * (Player.Status.IsSideView() ? (SpinDashSpeed / 1.5f) : SpinDashSpeed) + 12.0f);

                    switch (SpinDashVelocityType)
                    {
                        case 0:
                            kinematics->Velocity = newVelocity;
                            break;

                        case 1:
                            kinematics->Velocity += newVelocity;
                            break;
                        
                        default:
                            kinematics->Velocity = newVelocity;
                            break;
                    }

                    isVelocityAdded = true;
                }
            }    
        }
    }
    else
    {
        chargeCount = 1;
        isVelocityAdded = false; 
    }
}


