	if (SonicParametersInfo.pData == null)
		return;

    float SpinSmack = Player.Kinematics.GetMagnitude()

	RFL_SET_PARAM(SonicParametersInfo, common.commonPackage.attack.spinDash.velocity.Y, 5.0f);
	RFL_SET_PARAM(SonicParametersInfo, common.commonPackage.attack.spinDash.velocity.Z, SpinSmack);
    RFL_SET_PARAM(SonicParametersInfo, common.commonPackage.attack.spinDash.damageRate, SpinSmack*0.08f);

    RFL_SET_PARAM(SonicParametersInfo, common.commonPackage.attack.spinAttack.damageRate, SpinSmack*0.08f);
}


